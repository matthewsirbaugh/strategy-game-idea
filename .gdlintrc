# Naming and indentation consistency from explorations/shared-coding-guide.md.
# Its constants/enums and public/private/static members share groups; gdtoolkit cannot
# give those equal order, so declaration grouping stays a review check.
disable:
  - class-definitions-order
  - duplicated-load
  - function-arguments-number
  - max-file-lines
  - max-line-length
  - max-public-methods
  - max-returns
  - no-elif-return
  - no-else-return
function-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
class-name: '([A-Z][a-z0-9]*)+'
sub-class-name: '_?([A-Z][a-z0-9]*)+'
signal-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
class-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
class-load-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
function-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
function-preload-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
function-argument-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
loop-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'
enum-name: '([A-Z][a-z0-9]*)+'
enum-element-name: '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
constant-name: '_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
# Preloaded script aliases are class names (e.g. Model Library's Catalog/Stage).
load-constant-name: '(([A-Z][a-z0-9]*)+|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)'
excluded_directories: [.git, .godot]
