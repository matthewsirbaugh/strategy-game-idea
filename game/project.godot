; Engine configuration file.
; Edit through the Godot editor where possible.

config_version=5

[application]

config/name="Strategy Game Prototype"
run/main_scene="res://ui/title_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://autoload/settings.gd"
SceneRouter="*res://autoload/scene_router.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme.tres"

[input]

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
camera_rotate_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
camera_rotate_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
camera_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
camera_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
camera_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
camera_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
camera_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4,"pressed":true)]
}
camera_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5,"pressed":true)]
}
end_turn={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
cancel={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2,"pressed":true)]
}
toggle_network={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":78)]
}

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
